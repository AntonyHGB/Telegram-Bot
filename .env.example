# Token do BotFather. Nunca versione este arquivo.
TELEGRAM_BOT_TOKEN=your-token-here

# IDs do Telegram autorizados (IA, estudos, notas, voz, tarefa, status e lembretes).
# Vazio desabilita esses comandos (fail-closed).
ALLOWED_USER_IDS=

# Opcionais (valores padrao mostrados)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
VAULT_PROXY_URL=http://127.0.0.1:11435
ESTUDOS_PROXY_URL=http://127.0.0.1:11436
# Corpus de estudos local (no Docker e montado em /estudos)
ESTUDOS_PATH=/estudos
BOT_DB_PATH=bot_history.db
RATE_LIMIT_PER_MINUTE=5

# Ofertas dos grupos: janela, quantidade exibida e alerta por desconto minimo (%)
DEALS_WINDOW_HOURS=24
DEALS_TOP=5
DEALS_ALERT_PERCENT=50

# Piloto de ranking de ofertas com Jev (TypeSafe System One).
# Opt-in: basta definir JEV_API_KEY (a flag vazia liga o piloto). Use
# DEALS_JEV_RANKING=0 para forcar desligado mesmo com chave.
# Campos enviados por oferta: titulo generico do produto, preco, preco antigo,
# desconto e loja. Nunca saem usuario, grupo, link, mensagem bruta ou cupom.
DEALS_JEV_RANKING=
JEV_API_KEY=
JEV_MODEL=jev-1.13-free
JEV_TIMEOUT=8

# Historico de precos: compara o preco atual com a mediana/minimo de janelas
# anteriores. Sem amostra minima nao ha veredito ("sem historico suficiente").
# Retencao e dedupe evitam crescimento sem limite do banco.
DEALS_HISTORY_RETENTION_DAYS=90
DEALS_HISTORY_DEDUPE_HOURS=6
DEALS_HISTORY_MIN_SAMPLE=5
DEALS_HISTORY_WINDOWS_DAYS=7,30,90
DEALS_HISTORY_CHEAP_PCT=20

# Integracao do bot com Notion (independente do MCP do OpenCode)
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
# Whisper multilíngue em CPU/int8; cache persistente no volume Docker
WHISPER_MODEL=base
WHISPER_CACHE=/data/whisper
